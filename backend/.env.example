# Copy to .env.local and fill in the values. Never commit .env.local.

# Transaction-mode pooler (port 6543). Used by the running application.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432). Used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Signs the guest session token. Use a long random value.
JWT_SECRET="<random-string>"

PORT=3000

# "mock" until a real gateway provider is chosen.
PAYMENT_GATEWAY_MODE="mock"

# Shared secret the gateway signs callbacks with.
PAYMENT_GATEWAY_WEBHOOK_SECRET="<random-string>"

# The hotel's own static QRIS string. convertQRIS() injects each reservation total
# into it to produce a dynamic QR code.
QRIS_STATIC_CODE="<static-qris-string-from-your-provider>"

# Origin the guest opens to see and pay a QRIS code.
PUBLIC_BASE_URL="http://localhost:3000"

# Seed-only. prisma/seed.ts creates the first ADMIN account from these.
# Registration can only create a TAMU account, so this is the only way an admin
# is created. Change the password after seeding.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-password>"
